.444141936000051, "input_partitions": 8, "shuffles": 2, "code_lines": 7, "operators": "FileScan → InMemoryRelation → InMemoryTableScan → Filter → FileScan → Filter → Project → BroadcastExchange → BroadcastHashJoin → Project → HashAggregate → Exchange → HashAggregate → HashAggregate → Exchange → HashAggregate → AdaptiveSparkPlan", "groups": 25, "equivalent": true}, {"operation": "department_supplier_hhi", "description": "HHI de proveedores por departamento (join + dos agregaciones)", "engine": "RDD", "warmup_seconds": 8.51615025700005, "median_seconds": 6.00024755000004, "run1": 7.132125717000008, "run2": 6.00024755000004, "run3": 5.927656758000012, "input_partitions": 8, "shuffles": 3, "code_lines": 16, "operators": null, "groups": 25, "equivalent": true}], "code": {"category_amount": {"description": "Monto convocado total por categoría", "DataFrame": {"code": "def category_amount(processes, suppliers=None):\n    \"\"\"Monto convocado total por categoría.\"\"\"\n    return processes.groupBy('category').agg(F.sum('tender_amount_pen').alias('value'))\n", "lines": 1}, "RDD": {"code": "def category_amount(processes, suppliers=None):\n    \"\"\"Monto convocado total por categoría (los nulos cuentan como 0 en la suma).\"\"\"\n    return (\n        processes.select('category', 'tender_amount_pen')\n        .rdd.map(lambda row: (row[0], row[1] or 0.0))\n        .reduceByKey(lambda a, b: a + b)\n    )\n", "lines": 5}}, "buyer_count": {"description": "Número de procesos por entidad", "DataFrame": {"code": "def buyer_count(processes, suppliers=None):\n    \"\"\"Número de procesos por entidad compradora.\"\"\"\n    return processes.groupBy('buyer_id').agg(F.count('*').alias('value'))\n", "lines": 1}, "RDD": {"code": "def buyer_count(processes, suppliers=None):\n    \"\"\"Número de procesos por entidad compradora: el clásico conteo de palabras.\"\"\"\n    return processes.select('buyer_id').rdd.map(lambda row: (row[0], 1)).reduceByKey(lambda a, b: a + b)\n", "lines": 1}}, "department_supplier_hhi": {"description": "HHI de proveedores por departamento (join + dos agregaciones)", "DataFrame": {"code": "def department_supplier_hhi(processes, suppliers):\n    \"\"\"HHI de proveedores por departamento del comprador: join + dos agregaciones.\n\n    HHI = 10 000 · Σ v_i² / (Σ v_i)², con v_i el monto atribuido al proveedor i.\n    \"\"\"\n    by_supplier = (\n        suppliers.filter(F.col('allocated_amount_pen') > 0)\n        .join(processes.select('ocid', 'department'), 'ocid')\n        .groupBy('department', 'supplier_id')\n        .agg(F.sum('allocated_amount_pen').alias('v'))\n    )\n    return by_supplier.groupBy('department').agg((F.sum(F.col('v') ** 2) / F.sum('v') ** 2 * 10000).alias('value'))\n", "lines": 7}, "RDD": {"code": "def department_supplier_hhi(processes, suppliers):\n    \"\"\"HHI de proveedores por departamento: join por ocid y dos reduceByKey.\n\n    En lugar de agrupar todos los montos de un departamento (groupByKey), se acumulan\n    (Σv, Σv²) con reduceByKey, que combina localmente antes del shuffle.\n    \"\"\"\n    departments = processes.select('ocid', 'department').rdd.map(lambda row: (row[0], row[1]))\n    amounts = (\n        suppliers.select('ocid', 'supplier_id', 'allocated_amount_pen')\n        .rdd.filter(lambda row: row[2] is not None and row[2] > 0)\n        .map(lambda row: (row[0], (row[1], row[2])))\n    )\n    by_supplier = (\n        amounts.join(departments)  # (ocid, ((proveedor, v), dpto))\n        .map(lambda kv: ((kv[1][1], kv[1][0][0]), kv[1][0][1]))  # ((dpto, proveedor), v)\n        .reduceByKey(lambda a, b: a + b)\n    )\n    return (\n        by_supplier.map(lambda kv: (kv[0][0], (kv[1], kv[1] ** 2)))  # (dpto, (v, v²))\n        .reduceByKey(lambda a, b: (a[0] + b[0], a[1] + b[1]))\n        .mapValues(lambda s: s[1] / s[0] ** 2 * 10000)\n    )\n", "lines": 16}}}, "partitioning": {"input": {"files": 3, "read_partitions": 3, "after_repartition": 16, "explanation": "Gzip no es divisible: una partición por archivo. build_processes reparticiona a 16 antes de parsear para usar todos los núcleos."}, "pruning": {"year": 2024, "rows": 64619, "folders_total": 36, "folders_read_with_pruning": 12, "partition_column": {"seconds": 0.6205856389999553, "partition_filters": "isnotnull(year#78241), (year#78241 = 2024)", "pushed_filters": ""}, "other_column": {"seconds": 1.2169533399999182, "partition_filters": "", "pushed_filters": "IsNotNull(effective_date), GreaterThanOrEqual(effective_date,2024-01-01), LessThanOrEqual(effect"}}, "shuffle_partitions": [{"adaptive": false, "shuffle_partitions": 8, "seconds": 0.19994652700006554, "result_partitions": 8}, {"adaptive": false, "shuffle_partitions": 64, "seconds": 0.5284704140000258, "result_partitions": 64}, {"adaptive": false, "shuffle_partitions": 200, "seconds": 1.210313436999968, "result_partitions": 200}, {"adaptive": true, "shuffle_partitions": 8, "seconds": 0.22924358200009465, "result_partitions": 1}, {"adaptive": true, "shuffle_partitions": 64, "seconds": 0.10393969099993683, "result_partitions": 1}, {"adaptive": true, "shuffle_partitions": 200, "seconds": 0.09018201200001386, "result_partitions": 1}], "key_repartition": {"single_aggregation": {"direct": {"exchanges": 1, "seconds": 0.06479040599992913}, "repartition_first": {"exchanges": 1, "seconds": 0.10818046199995024}}, "two_aggregations_and_join": {"direct": {"exchanges": 2, "seconds": 0.08038011200005712}, "repartitioned_cached": {"exchanges": 0, "seconds": 0.18612970899994252}}}, "cluster": {"default_parallelism": 8, "executor_cores": "2", "cores_max": "4"}}, "spark_vs_pandas": [{"fraction": 0.1, "processes": 19628, "spark_seconds": 4.685000743000046, "pandas_seconds": 1.1117988329999662, "pandas_memory_mb": 3.340972, "groups_spark": 9, "groups_pandas": 9}, {"fraction": 0.5, "processes": 98138, "spark_seconds": 5.3679792429999225, "pandas_seconds": 1.0913432390000253, "pandas_memory_mb": 16.703363, "groups_spark": 9, "groups_pandas": 9}, {"fraction": 1.0, "proce