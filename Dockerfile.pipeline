FROM python:3.11-slim-bookworm
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=90 update \
    && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=90 install -y --no-install-recommends \
        openjdk-17-jre-headless \
        g++ \
        curl \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/opt/java PYTHONPATH=/workspace PYSPARK_PYTHON=python SPARK_HOME=/usr/local/lib/python3.11/site-packages/pyspark
RUN ln -s /usr/lib/jvm/java-17-openjdk-$(dpkg --print-architecture) /opt/java
WORKDIR /workspace
COPY requirements-pipeline.txt .
RUN pip install --no-cache-dir -r requirements-pipeline.txt
COPY src src
COPY tests tests
COPY pytest.ini .
CMD ["python", "-m", "src.run_all"]
