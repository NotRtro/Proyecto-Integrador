SPARK_MASTER_URL=spark://spark-master:7077
RAW_PATH=/data/raw
# Plantilla de descarga OCDS; {year} se reemplaza por cada año de ANALYSIS_YEARS.
OCDS_DOWNLOAD_URL=https://data.open-contracting.org/es/publication/135/download?name={year}.jsonl.gz
PROCESSED_PATH=/data/processed
ARTIFACTS_PATH=/artifacts
ANALYSIS_YEARS=2023,2024,2025
WEB_PORT=8501
RANDOM_SEED=42
SPARK_WORKER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=2g
SAMPLE_SIZE=1500
APRIORI_SAMPLE_SIZE=10000
